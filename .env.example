VITE_API_BASE_URL=http://localhost:8100/api

# Cloudinary — SIN prefijo VITE_: solo lo usan los scripts de Node, nunca el bundle
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# El cloud name del front NO se configura: sale de src/config/media.ts, que lo
# genera el mismo script que sube las fotos. Hay dos cuentas de Cloudinary —la
# del shoot y la de las fotos de las alumnas— y una variable suelta acá solo
# sirve para apuntar la landing a la cuenta equivocada.

# PayPhone — Cajita de Pagos (https://docs.payphone.app/cajita-de-pagos)
# 'simulation' = no se cobra nada. 'live' = cobro real.
VITE_PAYPHONE_MODE=simulation
VITE_PAYPHONE_TOKEN=
VITE_PAYPHONE_STORE_ID=
